# Copy to .env and fill in. Never commit .env.

# --- Required ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DATABASE_URL=postgresql+psycopg://nova:nova@localhost:5432/novalearn

# --- Server ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=./storage
MAX_DOCUMENT_MB=100
MAX_VIDEO_MB=1024

# --- AI providers ---
# This template uses Google AI Studio Gemini for both generation and embeddings.
# Put your AI Studio key in both LLM_API_KEY and EMBEDDING_API_KEY. Never commit .env.
#
# LLM_PROVIDER: none | openai | openai-compatible | ollama | anthropic | xai | google
# The live smoke check passed with gemini-3.5-flash-lite; 3.1-flash-lite is an alternative.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_BASE_URL=
VISION_ENABLED=true

# EMBEDDING_PROVIDER: local-hash | openai | openai-compatible | ollama | google
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Google Gemini supports requested 768-dimensional vectors; schema stores vector(768).
EMBEDDING_DIM=768

# STT_PROVIDER: none | whisper-local | openai   (whisper-local needs: pip install -r requirements-optional.txt)
STT_PROVIDER=none
STT_MODEL=whisper-1
STT_API_KEY=
STT_BASE_URL=

# Tesseract language codes, e.g. eng or eng+hin
OCR_LANGUAGE=eng
